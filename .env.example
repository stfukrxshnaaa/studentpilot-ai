# ========================================================
# StudyPilot AI - Environment Configuration Example
# ========================================================
# Copy this file to '.env' and fill in your actual API keys.
# NEVER commit your real '.env' file with secret keys to Git.
#
# NOTE: If no API key is provided, StudyPilot AI runs smoothly
# in Local Heuristic Demo Mode with realistic responses!

# LLM Provider Preference: 'gemini', 'openai', or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (Alternative high-speed inference: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Application Settings
STUDYPILOT_DB_PATH=data/studypilot.db
STUDYPILOT_DEBUG=False
